# Copy to .env.local (gitignored). Only the Supabase URL and anon key ever ship to the browser.
# Locally, `npm run env:local` fills these from `supabase status` using the Mac's Tailscale IP
# so the iPad and phone can reach the local stack.
VITE_SUPABASE_URL=http://<tailscale-ip>:54321
VITE_SUPABASE_ANON_KEY=<anon-key>
